{
  "name": "kyvora-studio-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev:web": "pnpm --filter @kyvora/web dev",
    "dev:desktop": "node scripts/launch-desktop.mjs",
    "desktop": "node scripts/launch-desktop.mjs",
    "start:desktop": "node scripts/launch-desktop.mjs",
    "dev:desktop:server": "pnpm --filter @kyvora/desktop dev",
    "tauri:dev": "pnpm --filter @kyvora/desktop tauri:dev",
    "tauri:build": "pnpm --filter @kyvora/desktop tauri:build",
    "build:web": "pnpm --filter @kyvora/web build",
    "build:desktop": "pnpm --filter @kyvora/desktop build",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @kyvora/web build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
